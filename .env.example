# Nebius Token Factory (default)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=replace-with-your-nebius-token-factory-key
LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# For NVIDIA NIM development, replace the values above with:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=replace-with-your-nvidia-api-key
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
