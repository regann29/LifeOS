# NVIDIA NIM
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-with-your-nvidia-api-key
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_ENABLE_THINKING=true
LLM_MAX_TOKENS=4096
LLM_REASONING_BUDGET=2048
LIFEOS_HOSTED=false
LIFEOS_DAILY_MODEL_CALL_CAP=500
TAVILY_API_KEY=replace-with-your-tavily-key

# For Nebius, set LLM_PROVIDER=nebius and copy the base URL, API key,
# and Nemotron model name from the Nebius Token Factory console.
